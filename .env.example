# Copy to .env and fill in. Never commit .env.

# --- Script writing (free key: https://aistudio.google.com -> Get API key) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- Stock footage + photos (free key: https://www.pexels.com/api/) ---
PEXELS_API_KEY=
# Optional, raises the free AI-image rate limit (https://auth.pollinations.ai)
# POLLINATIONS_TOKEN=

# --- YouTube upload (see README: "YouTube connect") ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# private | unlisted | public  (unverified Google projects can only upload private)
UPLOAD_PRIVACY=private
# Default YouTube quota fits about 6 uploads a day. Raise only after Google raises your quota.
UPLOADS_PER_DAY=6
# >0 = upload as private and schedule it to go public N hours apart
PUBLISH_GAP_HOURS=0
# 0 = only make videos, never upload
AUTO_UPLOAD=1
# Delete the mp4 of uploaded videos after this many days (script + info are kept)
KEEP_UPLOADED_DAYS=7

# --- Optional: trend research from YouTube (an API *key* from a DIFFERENT Google Cloud project) ---
# YOUTUBE_API_KEY=
REGION=IN

# --- Optional ---
# Line added at the end of every description
# CHANNEL_FOOTER=Follow for more!
# Voices (edge-tts names). Defaults: hi-IN-MadhurNeural / hi-IN-SwaraNeural / en-IN-PrabhatNeural / en-IN-NeerjaNeural
# VOICE_HI_MALE=hi-IN-MadhurNeural
# Video quality: lower CRF = better + bigger. Slower preset = smaller file, slower render.
# VIDEO_CRF=21
# X264_PRESET=veryfast
